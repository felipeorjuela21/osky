# SQLite (default, no Docker needed):
DATABASE_URL=sqlite:///./data/enterprise_agent.db
# PostgreSQL (docker compose up -d db):
# DATABASE_URL=postgresql+psycopg://agent:agent@localhost:5432/enterprise_agent
APP_ENV=development
LOG_LEVEL=INFO
AGENT_NAME=Osky
COMPANY_NAME=CeluWeb
WEBSITE_URL=https://www.celuweb.com/
# true = answer with the fake customers/sales demo tables
ENABLE_DEMO_DATA=false
# Neural voice: edge (free, prototype) | browser. Voices: es-CO-SalomeNeural, es-CO-GonzaloNeural...
TTS_PROVIDER=edge
TTS_VOICE=es-CO-GonzaloNeural
TTS_RATE=+6%
# Speech recognition: whisper (on this server) | browser. Model: base (fast) or small (more accurate)
STT_PROVIDER=whisper
STT_MODEL=base
# Clave del registro de conversaciones (?admin=1). Vacía en desarrollo = sin clave.
ADMIN_TOKEN=
